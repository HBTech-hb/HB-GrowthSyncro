{
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|css|js)",

      "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}